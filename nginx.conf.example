# ==========================================================================
# Configuração Nginx - Performance & Cache para go2apply
# Copie esta configuração para seu servidor Nginx
# ==========================================================================

server {
    listen 80;
    listen [::]:80;
    server_name go2apply.com.br www.go2apply.com.br;

    # Redirecionar HTTP para HTTPS (ative se tiver SSL)
    # return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;  # HTTP/2 melhora significativamente a performance
    listen [::]:443 ssl http2;
    server_name go2apply.com.br www.go2apply.com.br;

    # SSL Certificates (configure com seus certificados)
    # ssl_certificate /etc/ssl/certs/go2apply.crt;
    # ssl_certificate_key /etc/ssl/private/go2apply.key;

    root /var/www/html/go2apply.com.br;
    index index.html;

    # ==========================================================================
    # COMPRESSÃO GZIP
    # ==========================================================================
    gzip on;
    gzip_vary on;
    gzip_min_length 1000;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript
               application/x-javascript application/xml+rss
               application/javascript application/json
               application/x-font-ttf application/x-font-opentype
               application/vnd.ms-fontobject image/svg+xml;
    gzip_disable "msie6";

    # ==========================================================================
    # COMPRESSÃO BROTLI (se disponível)
    # ==========================================================================
    brotli on;
    brotli_comp_level 6;
    brotli_types text/plain text/css text/xml text/javascript
                 application/x-javascript application/xml+rss
                 application/javascript application/json
                 application/x-font-ttf application/x-font-opentype
                 application/vnd.ms-fontobject image/svg+xml;

    # ==========================================================================
    # CACHE CONTROL HEADERS
    # ==========================================================================

    # HTML: cache curto (1 hora)
    location ~* \.html$ {
        add_header Cache-Control "public, max-age=3600, must-revalidate";
        add_header X-Frame-Options "SAMEORIGIN";
    }

    # Assets estáticos (CSS, JS): cache longo (1 ano)
    location ~* \.(woff2|woff|ttf|eot|js|css)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        expires 365d;
    }

    # Imagens: cache moderado (7 dias)
    location ~* \.(jpg|jpeg|png|gif|webp|svg|ico)$ {
        add_header Cache-Control "public, max-age=604800";
        expires 7d;
    }

    # Vídeos: cache moderado (7 dias)
    location ~* \.(mp4|webm|ogv)$ {
        add_header Cache-Control "public, max-age=604800";
        expires 7d;
    }

    # ==========================================================================
    # SECURITY HEADERS
    # ==========================================================================
    add_header X-Content-Type-Options "nosniff";
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy "strict-origin-when-cross-origin";

    # ==========================================================================
    # DESABILITAR ACESSO A ARQUIVOS SENSÍVEIS
    # ==========================================================================
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # ==========================================================================
    # LOGGING
    # ==========================================================================
    access_log /var/log/nginx/go2apply.access.log;
    error_log /var/log/nginx/go2apply.error.log;
}
