    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Preciso instalar algum programa para usar o go2apply?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Não. O go2apply funciona direto no navegador, do computador ou do celular, sem precisar baixar nem instalar nada."
          }
        },
        {
          "@type": "Question",
          "name": "As calculadoras funcionam para qualquer cultura?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. A metodologia é baseada na compatibilidade dos ingredientes ativos e nas condições de aplicação, não em uma cultura específica, então funciona para a maioria das operações agrícolas."
          }
        },
        {
          "@type": "Question",
          "name": "Preciso ser especialista para usar as ferramentas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Não. As ferramentas guiam você passo a passo em cada cálculo, então dá para usar mesmo sem um conhecimento técnico aprofundado."
          }
        },
        {
          "@type": "Question",
          "name": "Posso usar o go2apply em mais de uma fazenda ou talhão?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Não há limite de fazendas ou talhões: você organiza suas operações e acompanha cada uma separadamente dentro da plataforma."
          }
        },
        {
          "@type": "Question",
          "name": "Como funciona o suporte técnico?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Através do nosso WhatsApp, e da nossa comunidade no Telegram, com uma equipe técnica disponível para tirar dúvidas e orientar sobre a melhor forma de extrair ao máximo tudo que cada ferramenta pode entregar."
          }
        }
      ]
